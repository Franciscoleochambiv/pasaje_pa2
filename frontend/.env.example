# Frontend environment example.
# Copy this file as frontend/.env and replace placeholder values.

# URL del API backend. Sin barra final.
# En desarrollo con proxy de Vite puede dejarse vacio:
# VITE_API_URL=
VITE_API_URL=http://localhost:8085

# URL WebSocket. Sin barra final.
# En desarrollo con proxy puede dejarse vacio:
# VITE_WS_URL=
VITE_WS_URL=ws://localhost:8085

# Google OAuth para login de clientes
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
